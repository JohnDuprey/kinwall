# Copy outside the checkout, chmod 600, and edit. Never put real tokens in this file.
DISCORD_TOKEN=replace-with-bot-token
GITHUB_TOKEN=replace-with-fine-grained-token
GITHUB_REPOSITORY=example/kinwall
DISCORD_GUILD_ID=100000000000000001
DISCORD_FORUM_ID=100000000000000002
DISCORD_SYNC_LABEL=discord
SYNC_INTERVAL_SECONDS=60
SYNC_DATA_DIR=/absolute/private/path/discord-sync
# Permanent attachment links require an HTTPS host; /assets is required.
PUBLIC_ASSET_BASE_URL=https://files.example.com/assets
# Optional: Discord tag name to GitHub label name. The labels are created if needed.
SYNC_TAG_MAP={}
# Required if the forum requires tags; use an existing tag ID.
DISCORD_DEFAULT_TAG=
# Optional: Discord thread ID to related issue number.
SYNC_RELATED_ISSUES={}
# Optional: strings to redact from Discord content before publishing to GitHub.
SYNC_REDACT_TERMS=[]
SYNC_HOST=127.0.0.1
SYNC_PORT=8098
